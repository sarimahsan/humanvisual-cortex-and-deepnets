# Feature caches (large binary arrays)
features/cache/*.npy
features/cache/*.npz
features/cache/*.json
!features/cache/.gitkeep

# Results directory and reports (keep local, do not push)
results/
BRAIN_ENCODING_RESULTS.md

# Generated figures directory (keep local, do not push)
figures/

